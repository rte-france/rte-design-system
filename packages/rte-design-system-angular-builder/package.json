{
  "name": "rte-design-system-angular-builder",
  "version": "0.1.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run build:tailwind",
    "build:tailwind": "npx tailwindcss -c ./projects/rte-design-system-angular/src/tailwind.config.ts -o ../rte-design-system-angular/styles/rte-tailwind.css --minify",
    "watch": "ng build --watch --configuration development",
    "watch:tailwind": "npx tailwindcss -c ./projects/rte-design-system-angular/src/tailwind.config.ts -o ../rte-design-system-angular/styles/rte-tailwind.css --watch --minify",
    "test": "ng test",
    "storybook": "npm run build:tailwind && ng run rte-design-system-angular:storybook",
    "build-storybook": "ng run rte-design-system-angular:build-storybook"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.13",
    "@angular/common": "^18.2.13",
    "@angular/compiler": "^18.2.13",
    "@angular/core": "^18.2.13",
    "@angular/forms": "^18.2.13",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/router": "^18.2.13",
    "rxjs": "~7.8.0",
    "tailwindcss-cli": "^0.1.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.12",
    "@angular/cli": "^18.2.12",
    "@angular/compiler-cli": "^18.2.13",
    "@chromatic-com/storybook": "^3.2.4",
    "@compodoc/compodoc": "^1.1.26",
    "@storybook/addon-docs": "^8.5.1",
    "@storybook/addon-essentials": "^8.5.1",
    "@storybook/addon-interactions": "^8.5.1",
    "@storybook/addon-onboarding": "^8.5.1",
    "@storybook/angular": "^8.5.1",
    "@storybook/blocks": "^8.5.1",
    "@storybook/test": "^8.5.1",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.20",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^18.2.1",
    "postcss": "^8.4.49",
    "storybook": "^8.5.1",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.4.2"
  }
}
